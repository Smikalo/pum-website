########################################
# GitHub / images (non-secret)
########################################
GITHUB_OWNER=smikalo
REPO_NAME=pum-website

########################################
# Node / general
########################################
NODE_ENV=development

########################################
# Web (Next.js app)
########################################

# Public (non-secret) API base; browser calls this URL
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Map style URL – replace YOUR_MAPTILER_KEY with your real key in your local .env (not committed)
NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/basic-v2-dark/style.json?key=YOUR_MAPTILER_KEY

# Internal server-to-server API base for SSR
API_BASE_INTERNAL=http://localhost:3001
API_BASE=http://localhost:3001

# Secret for /api/revalidate – choose a long random string in your real .env/.server env
REVALIDATE_SECRET=change-me-dev-revalidate-secret

########################################
# API / Express
########################################

# Port the API listens on
API_PORT=3001
API_LOG_LEVEL=info

# Origin of the web app (used for CORS, CSRF, cookies)
WEB_ORIGIN=http://localhost:3000

# Public URL for the API (used in emails, etc.)
PUBLIC_API_BASE=http://localhost:3001

########################################
# Database (Postgres in docker-compose)
########################################
POSTGRES_DB=pum
POSTGRES_USER=pum
POSTGRES_PASSWORD=devpass

# Prisma / API DB URL – keep consistent with POSTGRES_* above
DATABASE_URL=postgresql://pum:devpass@db:5432/pum?schema=public

########################################
# Auth / JWT / cookies
########################################

# Use a long random string in real envs.
# This dev value is fine to keep in the repo because it should never be used in production.
JWT_ACCESS_SECRET=dev-only-change-me

# TTLs (non-secret)
JWT_ACCESS_TTL_SEC=900       # 15 minutes
JWT_REFRESH_TTL_DAYS=30

# Cookie names / flags
REFRESH_COOKIE_NAME=refreshToken
CSRF_COOKIE_NAME=XSRF-TOKEN
COOKIE_SECURE=false          # true in production over HTTPS
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/auth

########################################
# Rate limiting (non-secret)
########################################
LOGIN_RATE_WINDOW_MS=600000  # 10 minutes
LOGIN_RATE_MAX=10

PUBLIC_RATE_WINDOW_MS=60000  # 1 minute
PUBLIC_RATE_MAX=100

# Legacy / generic rate limit (if used)
RATE_LIMIT_MAX=200

########################################
# Mail / newsletter
########################################

# From address used in emails
MAIL_FROM=contact@the-pum.com

# Newsletter signing secret (non-secret in dev; use a random string in prod)
NEWSLETTER_SECRET=dev-only-newsletter-secret

# SMTP – FILL REAL VALUES IN YOUR LOCAL .ENV ONLY
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=contact@the-pum.com
SMTP_PASS=change-me-dev-smtp-password
